# Ultra-fast container from pre-built dist
# Run 'npm run build' before running 'docker build -f Dockerfile.dist -t vegbazar-frontend .'
# Final size: ~25MB | RAM: ~6MB | CPU: ~0%
FROM nginx:alpine-slim

COPY dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
